From 866c9b520266d5e63f840ac900c032632d50337a Mon Sep 17 00:00:00 2001
From: woaphone <woaphone@local>
Date: Thu, 5 Nov 2026 02:03:56 +0800
Subject: [PATCH 07/18] rothko: restore exit-boot-services GIC state before
 CNTV enable (irq5)

DarwinBoot enters XNU without ExitBootServices, leaving the firmware's
ICC_IGRPEN1_EL1 and timer PPIs live; fiq_context_init then enables CNTV
and spllo takes PPI 27 before ArmCpu installs the IRQ handler.  Clear
ICC_IGRPEN1_EL1 on the boot CPU before fiq_context_init (ArmCpu re-enables
it after installing its handler), record IRQ state at spllo, guard a NULL
handler with an explicit panic, and trace handler install/first dispatch.

diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
index e95a195..143442b 100644
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -232,6 +232,78 @@ k70u_startup_event(const char *event, uint64_t subsystem, uint64_t rank,
 	out[n++] = '\n'; out[n] = 0; k70u_pmsg(out);
 }
 
+/*
+ * [k70u irq5 2026-11-05] GIC hand-off contract.
+ *
+ * DarwinBoot enters the kernel without ExitBootServices, so ArmGicDxe and
+ * ArmTimerDxe never run their exit handlers: ICC_IGRPEN1_EL1 stays 1 and the
+ * firmware timer PPIs stay enabled.  fiq_context_init() then enables CNTV
+ * (PPI 27) and the first spllo() takes it in sleh_irq() before ArmCpu has
+ * installed cpu_data->interrupt_handler (trace4: pc=0 after _sleh_irq blr x8).
+ * Restore the exit-boot-services state on the boot CPU: Group 1 signalling
+ * stays off until ArmCpu::enableGic() sets ICC_IGRPEN1_EL1 again, which it
+ * does only after enableCPUInterrupt() installed its handler.
+ *
+ * ICC registers use their generic encodings:
+ *   ICC_SRE_EL1     S3_0_C12_C12_5    ICC_IGRPEN1_EL1 S3_0_C12_C12_7
+ *   ICC_HPPIR1_EL1  S3_0_C12_C12_2    ICC_PMR_EL1     S3_0_C4_C6_0
+ * They are touched only when ICC_SRE_EL1.SRE is 1 (system-register access).
+ */
+void
+k70u_irq_hex(const char *name, uint64_t value)
+{
+	char out[112];
+	const char *prefix = "K70U-IRQ5: ";
+	unsigned n = 0;
+	while (*prefix) out[n++] = *prefix++;
+	if (name) while (*name && n < 80) out[n++] = *name++;
+	out[n++] = '='; out[n++] = '0'; out[n++] = 'x';
+	for (int shift = 60; shift >= 0; shift -= 4)
+		out[n++] = "0123456789abcdef"[(value >> shift) & 15];
+	out[n++] = '\n'; out[n] = 0;
+	k70u_pmsg(out);
+}
+
+void
+k70u_irq_state(const char *where)
+{
+	uint64_t value;
+
+	k70u_trace("IRQ5 state", where);
+	__asm__ volatile ("mrs %0, S3_0_C12_C12_5" : "=r"(value));
+	k70u_irq_hex("icc_sre", value);
+	if ((value & 1) != 0) {
+		__asm__ volatile ("mrs %0, S3_0_C12_C12_7" : "=r"(value));
+		k70u_irq_hex("icc_igrpen1", value);
+		__asm__ volatile ("mrs %0, S3_0_C4_C6_0" : "=r"(value));
+		k70u_irq_hex("icc_pmr", value);
+		__asm__ volatile ("mrs %0, S3_0_C12_C12_2" : "=r"(value));
+		k70u_irq_hex("icc_hppir1", value);
+	}
+	__asm__ volatile ("mrs %0, CNTV_CTL_EL0" : "=r"(value));
+	k70u_irq_hex("cntv_ctl", value);
+	__asm__ volatile ("mrs %0, CNTP_CTL_EL0" : "=r"(value));
+	k70u_irq_hex("cntp_ctl", value);
+	__asm__ volatile ("mrs %0, DAIF" : "=r"(value));
+	k70u_irq_hex("daif", value);
+}
+
+static void
+k70u_gic_handoff_quiesce(void)
+{
+	uint64_t sre;
+
+	k70u_irq_state("arm_init firmware hand-off");
+	__asm__ volatile ("mrs %0, S3_0_C12_C12_5" : "=r"(sre));
+	if ((sre & 1) == 0) {
+		k70u_trace("IRQ5 quiesce", "skipped: ICC_SRE_EL1.SRE=0");
+		return;
+	}
+	__asm__ volatile ("msr S3_0_C12_C12_7, xzr\n\tisb" ::: "memory");
+	k70u_trace("IRQ5 quiesce", "ICC_IGRPEN1_EL1 cleared before fiq_context_init");
+	k70u_irq_state("arm_init after quiesce");
+}
+
 /* Enabled only once arm_vm_init() has run - before that ml_io_map() is unsafe. */
 static void
 k70u_beacon_on(void)
@@ -799,6 +871,8 @@ arm_init(
 #endif /* KPERF */
 
 	PE_init_cpu();
+	/* [k70u irq5] Group 1 off before CNTV is enabled; ArmCpu re-enables it. */
+	k70u_gic_handoff_quiesce();
 	fiq_context_init(TRUE);
 
 
diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
index 705a6f3..c760975 100644
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -901,6 +901,10 @@ ml_install_interrupt_handler(
 	cpu_data_ptr->interrupt_handler = handler;
 	cpu_data_ptr->interrupt_refCon = refCon;
 
+	/* [k70u irq5] proves the platform provider reached handler installation */
+	k70u_irq_hex("install handler", (uint64_t)(uintptr_t)handler);
+	k70u_irq_hex("install source", (uint64_t)(uint32_t)source);
+
 	(void) ml_set_interrupts_enabled(current_state);
 }
 
diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index c71a36b..b310f23 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -2507,11 +2507,29 @@ sleh_irq(arm_saved_state_t *state)
 #if USE_APPLEARMSMP
 	PE_handle_ext_interrupt();
 #else
+	/*
+	 * [k70u irq5] No IRQ may be taken before the platform interrupt provider
+	 * (ArmCpu) installs its handler.  Record which interrupt broke that
+	 * contract instead of branching to address 0.
+	 */
+	if (__improbable(cdp->interrupt_handler == NULL)) {
+		k70u_irq_state("sleh_irq without an installed handler");
+		panic("sleh_irq: IRQ taken before the platform interrupt provider installed a handler");
+	}
+	static uint32_t k70u_irq_logged;
+	const uint32_t k70u_irq_first = k70u_irq_logged < 2;
+	if (k70u_irq_first) {
+		k70u_irq_hex("dispatch handler", (uint64_t)(uintptr_t)cdp->interrupt_handler);
+	}
 	/* Run the registered interrupt handler. */
 	cdp->interrupt_handler(cdp->interrupt_target,
 	    cdp->interrupt_refCon,
 	    cdp->interrupt_nub,
 	    cdp->interrupt_source);
+	if (k70u_irq_first) {
+		k70u_irq_logged++;
+		k70u_trace("IRQ5 dispatch", "handler returned");
+	}
 #endif
 
 	entropy_collect();
diff --git a/osfmk/kern/k70u_trace.h b/osfmk/kern/k70u_trace.h
index a0a7afe..b028502 100644
--- a/osfmk/kern/k70u_trace.h
+++ b/osfmk/kern/k70u_trace.h
@@ -9,11 +9,15 @@ void k70u_pmsg(const char *);
 void k70u_trace_hex(const char *, uint64_t);
 void k70u_trace(const char *, const char *);
 void k70u_startup_event(const char *, uint64_t, uint64_t, uint64_t, uint64_t);
+void k70u_irq_hex(const char *, uint64_t);
+void k70u_irq_state(const char *);
 #else
 #define k70u_pmsg(s) ((void)0)
 #define k70u_trace_hex(a,b) ((void)0)
 #define k70u_trace(a,b) ((void)0)
 #define k70u_startup_event(a,b,c,d,e) ((void)0)
+#define k70u_irq_hex(a,b) ((void)0)
+#define k70u_irq_state(a) ((void)0)
 #endif
 #ifdef __cplusplus
 }
diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
index f2953e6..c1f1d36 100644
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -769,6 +769,7 @@ kernel_bootstrap_thread(void)
 	// Reset interrupts masked timeout before we enable interrupts
 	ml_spin_debug_clear_self();
 #endif
+	k70u_irq_state("spllo enter");
 	k70u_trace("bootstrap-thread-call", "spllo enter");
 	(void) spllo();
 	k70u_trace("bootstrap-thread-call", "spllo returned");         /* Allow interruptions */
