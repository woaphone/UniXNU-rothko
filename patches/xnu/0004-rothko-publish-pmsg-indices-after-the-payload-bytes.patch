From bd2887af82886e0ac4afbba7f06cffbbb3b262e4 Mon Sep 17 00:00:00 2001
From: woaphone <69346114+woaphone@users.noreply.github.com>
Date: Wed, 4 Nov 2026 14:19:05 +0800
Subject: [PATCH 04/18] rothko: publish pmsg indices after the payload bytes


diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
index f614360..4860495 100644
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -143,14 +143,8 @@ k70u_beacon(const char *msg)
 	}
 
 	count = len;
-	if ((uintptr_t)hdr[2] < capacity) {
-		uintptr_t grown = (uintptr_t)hdr[2] + count;
-		hdr[2] = (uint32_t)((grown > capacity) ? capacity : grown);
-	}
-
+	uintptr_t grown = (uintptr_t)hdr[2] + count;
 	start = (uintptr_t)hdr[1];
-	hdr[1] = (uint32_t)((start + count) % capacity);
-
 	first = capacity - start;
 	if (first > count) {
 		first = count;
@@ -163,6 +157,9 @@ k70u_beacon(const char *msg)
 	}
 
 	__asm__ volatile("dsb sy" ::: "memory");
+	hdr[1] = (uint32_t)((start + count) % capacity);
+	hdr[2] = (uint32_t)((grown > capacity) ? capacity : grown);
+	__asm__ volatile("dsb sy" ::: "memory");
 }
 
 void
