From 142fc32699a9faeb9e81fb93705319ec76ae0aaf Mon Sep 17 00:00:00 2001
From: woaphone <69346114+woaphone@users.noreply.github.com>
Date: Thu, 5 Nov 2026 19:44:21 +0800
Subject: [PATCH 12/18] rothko: submit compositor CMD frames and record fatal
 signal state (unx7)


diff --git a/bsd/dev/arm/unix_signal.c b/bsd/dev/arm/unix_signal.c
index 11cfbcf..b976a2a 100644
--- a/bsd/dev/arm/unix_signal.c
+++ b/bsd/dev/arm/unix_signal.c
@@ -270,6 +270,46 @@ struct user_sigframe32 {
 	mcontext32_t            mctx;
 };
 
+/* Default fatal signals never call sendsig(). Keep the real terminating
+ * thread state in the existing console/Log path before coredump/exit. */
+void
+k70u_fatal_signal(int sig)
+{
+#if defined(__arm64__)
+	struct proc *p = current_proc();
+	static unsigned fatal_logs;
+	if ((sig != SIGABRT && sig != SIGTRAP && sig != SIGSEGV) ||
+	    !proc_is64bit_data(p) || fatal_logs >= 24) {
+		return;
+	}
+	arm_thread_state64_t state;
+	mach_msg_type_number_t count = ARM_THREAD_STATE64_COUNT;
+	if (thread_getstatus(current_thread(), ARM_THREAD_STATE64,
+	    (thread_state_t)&state, &count) != KERN_SUCCESS) {
+		return;
+	}
+	fatal_logs++;
+	printf("K70U-FATAL7: n=%u pid=%d name=%.20s sig=%d pc=%llx lr=%llx fp=%llx sp=%llx\n",
+	    fatal_logs, proc_getpid(p), p->p_comm, sig,
+	    (unsigned long long)state.pc, (unsigned long long)state.lr,
+	    (unsigned long long)state.fp, (unsigned long long)state.sp);
+	uint64_t fp = state.fp;
+	for (int i = 0; i < 8 && fp > 0x10000ULL && fp < 0x800000000000ULL; i++) {
+		uint64_t frame[2];
+		if (copyin((user_addr_t)fp, frame, sizeof(frame)) != 0) {
+			break;
+		}
+		printf("K70U-FATAL7: frame=%d ra=%llx\n", i, (unsigned long long)frame[1]);
+		if (frame[0] <= fp) {
+			break;
+		}
+		fp = frame[0];
+	}
+#else
+	(void)sig;
+#endif
+}
+
 /*
  * Send an interrupt to process.
  *
diff --git a/bsd/kern/kern_sig.c b/bsd/kern/kern_sig.c
index 8a91229..45a2a80 100644
--- a/bsd/kern/kern_sig.c
+++ b/bsd/kern/kern_sig.c
@@ -150,6 +150,7 @@ int killpg1(proc_t, int, int, int, int);
 kern_return_t do_bsdexception(int, int, int);
 void __posix_sem_syscall_return(kern_return_t);
 char *proc_name_address(void *p);
+void k70u_fatal_signal(int sig);
 
 static int      filt_sigattach(struct knote *kn, struct kevent_qos_s *kev);
 static void     filt_sigdetach(struct knote *kn);
@@ -3108,6 +3109,7 @@ postsig_locked(int signum)
 			p->p_sigacts.ps_sig = signum;
 			proc_signalend(p, 1);
 			proc_unlock(p);
+			k70u_fatal_signal(signum);
 			if (task_is_driver(proc_task(p))) {
 				coredump_flags |= COREDUMP_FULLFSYNC;
 			}
diff --git a/osfmk/console/video_console.c b/osfmk/console/video_console.c
index f04065f..f1cc8f6 100644
--- a/osfmk/console/video_console.c
+++ b/osfmk/console/video_console.c
@@ -1280,6 +1280,7 @@ static volatile uint32_t k70u_display_dirty;
 static volatile int k70u_display_state;      /* 0 not started, 1 running, -1 refused */
 static uint32_t k70u_display_ms = 1000;
 static uint64_t k70u_display_pushes;
+static uint64_t k70u_display_presents;
 static uint64_t k70u_display_hb_last;
 volatile uint32_t k70u_display_busy;
 
@@ -1390,6 +1391,7 @@ k70u_display_push(void)
 	if (!__sync_bool_compare_and_swap(&k70u_display_busy, 0, 1)) {
 		return;
 	}
+	k70u_display_dirty = 0;
 	__asm__ volatile ("dsb sy" ::: "memory");
 	for (uint32_t row = 0; row < K70U_FB_HEIGHT; row++) {
 		const volatile uint64_t *src = (const volatile uint64_t *)(k70u_fb_l0 + (uint64_t)row * K70U_FB_L0_ROW);
@@ -1414,8 +1416,7 @@ k70u_display_push(void)
 static void
 k70u_display_tick(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
 {
-	if (k70u_display_dirty) {
-		k70u_display_dirty = 0;
+	if (k70u_display_dirty && (!yunluo_video_console_frozen || k70u_display_presents)) {
 		k70u_display_push();
 	}
 	uint64_t now = mach_absolute_time();
@@ -1436,6 +1437,21 @@ k70u_display_tick(__unused thread_call_param_t p0, __unused thread_call_param_t
 	thread_call_enter_delayed(&k70u_display_call, deadline);
 }
 
+/* The compositor has finished writing L0. Publish L1 and trigger the CMD
+ * panel now, even though the text console has been frozen by scanout. */
+void
+k70u_display_present(void)
+{
+	k70u_display_presents++;
+	k70u_display_dirty = 1;
+	k70u_display_push();
+	if (k70u_display_presents == 1) {
+		printf("K70U-DISPLAY7: compositor present=%llu pushes=%llu\n",
+		    (unsigned long long)k70u_display_presents,
+		    (unsigned long long)k70u_display_pushes);
+	}
+}
+
 void
 k70u_display_start(void)
 {
