 #define k70u_irq_state(a) ((void)0)
+#define k70u_display_start() ((void)0)
 #endif
 #ifdef __cplusplus
 }
diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
index c1f1d36..045bee8 100644
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -780,6 +780,8 @@ kernel_bootstrap_thread(void)
 	k70u_trace("bootstrap-thread-call", "initialize_screen enter");
 	initialize_screen(NULL, kPEAcquireScreen);
 	k70u_trace("bootstrap-thread-call", "initialize_screen returned");
+	/* [k70u unx1] command-mode DSI: start pushing console frames to the panel */
+	k70u_display_start();
 
 	/*
 	 *	Initialize the shared region module.
