From aecab18b37c7f9fda3710b37aea09bc132c64851 Mon Sep 17 00:00:00 2001
From: woaphone <woaphone@local>
Date: Thu, 5 Nov 2026 07:02:53 +0800
Subject: [PATCH 08/18] rothko: push console frames to the command-mode DSI
 panel, mirror console to pmsg (unx1)

The panel only shows frames that are pushed; after the UEFI hand-off nothing
pushed them, so XNU text never appeared.  A thread_call copies layer 0 (the
console framebuffer) into layer 1 and replays RothkoDisplayDxe's mutex/DSI
start sequence when the console changed (k70u-dsi, k70u-dsi-ms); panic text
pushes on every newline.  Console lines are mirrored to pmsg (k70u-con), the
startup-callback trace that wrapped the pmsg ring is opt-in (k70u-callbacks),
and a 10 s heartbeat reports IRQ and push counts.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
index 143442b..c66441d 100644
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -219,6 +219,16 @@ void
 k70u_startup_event(const char *event, uint64_t subsystem, uint64_t rank,
     uint64_t function, uint64_t argument)
 {
+	/* [k70u unx1] ~4800 lines per boot wrapped the pmsg ring; opt-in now. */
+	static int k70u_callbacks = -1;
+	if (k70u_callbacks < 0) {
+		uint32_t value = 0;
+		PE_parse_boot_argn("k70u-callbacks", &value, sizeof(value));
+		k70u_callbacks = value ? 1 : 0;
+	}
+	if (!k70u_callbacks) {
+		return;
+	}
 	char out[384];
 	unsigned n = k70u_copy(out, 0, "K70U-CALLBACK3: ");
 	const uint64_t values[4] = {subsystem, rank, function, argument};
